      "qa": [
        {
          "question": "Why is it important?",
          "answer": "Without measurable feedback, golfers can struggle to identify what needs to change. Quantitative motion analysis gives them a clear basis for adjusting their swing and improving more efficiently.",
          "highlights": [
            "measurable feedback"
          ]
        },
        {
          "question": "Why do we do it?",
          "answer": "Golf is our entry point into sports technology, combining advanced AI pose estimation with established coaching criteria to validate the concept and build a viable business.",
          "highlights": [
            "entry point into sports technology"
          ]
        },
        {
          "question": "What is the challenge?",
          "answer": "Consumer-grade footage often contains severe motion blur, leading to missed detections. Body joints can also be occluded from the camera’s viewpoint.",
          "highlights": [
            "severe motion blur",
            "occluded"
          ]
        },
        {
          "question": "How do we solve the problem?",
          "answer": "We train a unified model on in-house datasets with custom annotation specifications, use segmentation-based augmentation, and apply custom smoothing for fluid, accurate trajectories.",
          "highlights": [
            "custom annotation specifications",
            "custom smoothing"
          ]
        },
        {
          "question": "What’s next?",
          "answer": "Next, we’ll turn 2D detections into metrics based on established golf-coaching criteria and explore LLM-generated swing guidance.",
          "highlights": [
            "2D detections into metrics",
            "LLM-generated swing guidance"
          ]
        }
      ]
    },
