      "qa": [
        {
          "question": "Why is it important?",
          "answer": "Perspective distortion can skew 2D measurements. Reconstructing the swing in 3D enables more accurate angle measurements and clearer guidance for improvement.",
          "highlights": [
            "Perspective distortion",
            "more accurate angle measurements"
          ]
        },
        {
          "question": "Why do we do it?",
          "answer": "Most 3D joint-tracking products still rely on expensive marker-based systems. We aim to break this barrier with AI and build a scalable, profitable business.",
          "highlights": [
            "expensive marker-based systems",
            "scalable, profitable business"
          ]
        },
        {
          "question": "What is the challenge?",
          "answer": "Accurate 3D reconstruction usually requires camera calibration and synchronized recordings, both impractical for everyday users. Maintaining accuracy without them is one challenge; reconciling different practitioners’ body-angle definitions is another.",
          "highlights": [
            "camera calibration and synchronized recordings",
            "body-angle definitions"
          ]
        },
        {
          "question": "How do we solve the problem?",
          "answer": "We estimate spatial relationships using golf-specific priors, provide an intuitive UI for manual time synchronization, and visualize rotation definitions for clarity.",
          "highlights": [
            "spatial relationships",
            "manual time synchronization",
            "rotation definitions"
          ]
        },
        {
          "question": "What’s next?",
          "answer": "We’ll strengthen our algorithms, automate synchronization, and improve device capture quality, then combine motion data with golf-informed AI to automatically generate swing guidance.",
          "highlights": [
            "automate synchronization",
            "device capture quality",
            "automatically generate swing guidance"
          ]
        }
      ]
    }
